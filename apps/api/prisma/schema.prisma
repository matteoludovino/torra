// Models arrive stage by stage; hand-written SQL (triggers, constraints, full-text) lives in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A customer's private corner of the store. Every account gets one (a one-click demo's lasts a day; a
/// signed-up customer's has no end): they see the shared catalog plus what they themselves wrote (cart,
/// orders, stock reservations), never anyone else's. Deleting a sandbox removes all of that.
model Sandbox {
  id             String             @id @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  /// Null: kept (a signed-up customer). Set: removed after this moment (a demo).
  expiresAt      DateTime?          @db.Timestamptz(3)
  outboxEvents   OutboxEvent[]
  users          User[]
  sentEmails     SentEmail[]
  products       Product[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  carts          Cart[]
  coupons        Coupon[]
  redemptions    CouponRedemption[]
  orders         Order[]

  @@index([expiresAt])
  @@map("sandboxes")
}

/// Domain events written in the same transaction as the change they describe, then handled by the
/// in-process scheduler (emails, delayed rules). A row is handled once: claimed with SKIP LOCKED, retried
/// with backoff on failure, given up after too many attempts.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(60)
  payload     Json
  sandboxId   String?   @db.Uuid
  sandbox     Sandbox?  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  dueAt       DateTime  @default(now()) @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([processedAt, failedAt, dueAt])
  @@map("outbox_events")
}

enum Role {
  customer
  admin
}

/// An account. Customers always live in a sandbox; the store's own admins (who run the shared catalog)
/// have none.
model User {
  id              String             @id @db.Uuid
  /// Trimmed and lower-cased. Never sent to anyone but its owner (and the store's admins).
  email           String             @unique @db.VarChar(254)
  name            String             @db.VarChar(60)
  /// Argon2id. Null: can't sign in with a password (demo personas).
  passwordHash    String?
  role            Role               @default(customer)
  emailVerifiedAt DateTime?          @db.Timestamptz(3)
  sandboxId       String?            @db.Uuid
  sandbox         Sandbox?           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// Email categories this person turned off (account and order receipts can't be).
  emailOptOuts    String[]           @default([])
  /// Set by an admin: can't sign in.
  suspendedAt     DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  sessions        Session[]
  emailTokens     EmailToken[]
  cart            Cart?
  redemptions     CouponRedemption[]
  orders          Order[]

  @@index([sandboxId])
  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id @db.Uuid
  tokenHash Bytes    @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

enum EmailTokenPurpose {
  verify_email
  reset_password
}

/// A link sent by email (verify the address, reset the password). Stored as SHA-256, used once.
model EmailToken {
  id        String            @id @db.Uuid
  tokenHash Bytes             @unique
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Emails kept instead of (or as well as) sent: every email when no SMTP server is configured, and
/// always for demo accounts, whose visitors read them in the app's demo inbox.
model SentEmail {
  id        String   @id @db.Uuid
  sandboxId String?  @db.Uuid
  sandbox   Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  to        String   @db.VarChar(254)
  kind      String   @db.VarChar(60)
  subject   String
  text      String
  html      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([sandboxId, createdAt])
  @@index([userId, createdAt])
  @@map("sent_emails")
}

/// What admins did, append-only (the database refuses changes; see the migration).
model AuditEntry {
  id         String   @id @db.Uuid
  actorId    String   @db.Uuid
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(30)
  targetId   String?  @db.Uuid
  details    Json     @default("{}")
  sandboxId  String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([sandboxId, createdAt(sort: Desc)])
  @@map("audit_entries")
}

enum ProductKind {
  /// Shipped: has weight, stock and shipping.
  physical
  /// Downloaded: no stock, no shipping; access is granted per purchased item.
  digital
}

/// Something the store sells. Shared (no sandbox) products are the catalog everyone sees; a demo's admin
/// may add products that live only in their sandbox.
model Product {
  id          String                   @id @db.Uuid
  sandboxId   String?                  @db.Uuid
  sandbox     Sandbox?                 @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  slug        String                   @db.VarChar(80)
  kind        ProductKind
  category    String                   @db.VarChar(30)
  title       String                   @db.VarChar(100)
  subtitle    String                   @db.VarChar(160)
  description String
  /// Which built-in illustration shows it (no uploads: the free host has no persistent disk).
  art         String                   @db.VarChar(40)
  /// The names of the choices a variant is made of, in order ("Peso", "Moagem"); none for a single variant.
  optionNames String[]                 @default([])
  /// Order in the storefront (lower first).
  position    Int                      @default(0)
  active      Boolean                  @default(true)
  /// Full text (title, subtitle, description), generated by the database: see the catalog migration.
  search      Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('pt_unaccent'::regconfig, (title)::text), 'A'::\"char\") || setweight(to_tsvector('pt_unaccent'::regconfig, (subtitle)::text), 'B'::\"char\")) || setweight(to_tsvector('pt_unaccent'::regconfig, description), 'C'::\"char\"))"))
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(3)
  variants    Variant[]

  @@unique([slug, sandboxId])
  @@index([category, position])
  @@index([search], type: Gin)
  @@map("products")
}

/// One buyable form of a product (250 g in grains, 1 kg ground for espresso…), with its own price and stock.
model Variant {
  id             String          @id @db.Uuid
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Always the product's sandbox (checked by the database).
  sandboxId      String?         @db.Uuid
  sku            String          @db.VarChar(40)
  /// One value per name in the product's optionNames, in the same order.
  optionValues   String[]        @default([])
  priceCents     Int
  /// A former price, shown struck through.
  compareAtCents Int?
  /// Physical variants only: what shipping is priced on.
  weightGrams    Int?
  position       Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([sku, sandboxId])
  @@index([productId, position])
  @@map("variants")
}

/// How many units of a physical variant are available in one corner of the store: the shared catalog's
/// (no sandbox) or one sandbox's own copy, made on its first use. Kept by a trigger from the movements,
/// never written directly, and never below zero.
model StockLevel {
  id        String   @id @db.Uuid
  variantId String   @db.Uuid
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sandboxId String?  @db.Uuid
  sandbox   Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  available Int
  updatedAt DateTime @db.Timestamptz(3)

  /// NULLS NOT DISTINCT in the migration: one shared row per variant, one per sandbox.
  @@unique([variantId, sandboxId])
  @@map("stock_levels")
}

enum StockMovementKind {
  /// Initial stock of the shared catalog (or of a demo's own product).
  seed
  /// A sandbox's first touch of a shared variant: its copy starts from the shared balance at that moment.
  copy
  /// An admin's correction, with a reason.
  adjust
  /// Held for an order waiting for payment.
  reserve
  /// Given back: the order expired or was cancelled before shipping.
  release
  /// Back on the shelf after a refund.
  restock
}

/// Every change to stock, append-only (the database refuses edits and deletes). A level is the sum of its
/// movements: the balance can always be explained.
model StockMovement {
  id        String            @id @db.Uuid
  variantId String            @db.Uuid
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sandboxId String?           @db.Uuid
  sandbox   Sandbox?          @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  kind      StockMovementKind
  /// Signed: +10 seeds ten, -2 reserves two.
  quantity  Int
  /// The order a reservation, release or restock belongs to.
  orderId   String?           @db.Uuid
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String?
  actorId   String?           @db.Uuid
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([orderId, variantId, kind])
  @@index([variantId, sandboxId])
  @@map("stock_movements")
}

/// A shopping cart: a signed-in customer's (one, in their sandbox) or a visitor's (behind a cookie that
/// holds a random token; only its SHA-256 is stored). Signing in moves a visitor's cart into the account's.
/// Holds no stock: units are reserved when an order is placed.
model Cart {
  id        String     @id @db.Uuid
  userId    String?    @unique @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash Bytes?     @unique
  sandboxId String?    @db.Uuid
  sandbox   Sandbox?   @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  /// A visitor's cart left alone for 30 days is removed.
  updatedAt DateTime   @db.Timestamptz(3)
  items     CartItem[]
  orders    Order[]

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  cartId         String   @db.Uuid
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String   @db.Uuid
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int
  /// The price when it was added (or last acknowledged): only to say "the price changed". What is
  /// charged is always the variant's current price.
  seenPriceCents Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([cartId, variantId])
  @@map("cart_items")
}

enum CouponKind {
  percent
  fixed
}

/// A discount code. The shared catalog's (no sandbox) work for every customer, their total limit counted
/// per customer's corner of the store (one customer can't use up another's); a demo's admin may create
/// codes for their own sandbox, which never reuse a shared code.
model Coupon {
  id               String             @id @db.Uuid
  sandboxId        String?            @db.Uuid
  sandbox          Sandbox?           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// Upper case, no spaces.
  code             String             @db.VarChar(30)
  kind             CouponKind
  /// A percentage (1-100) or an amount in centavos.
  value            Int
  minSubtotalCents Int                @default(0)
  startsAt         DateTime?          @db.Timestamptz(3)
  endsAt           DateTime?          @db.Timestamptz(3)
  /// Uses allowed per corner of the store (null: unlimited).
  maxRedemptions   Int?
  oncePerCustomer  Boolean            @default(false)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  redemptions      CouponRedemption[]
  orders           Order[]

  @@unique([code, sandboxId])
  @@map("coupons")
}

/// A coupon held by an order (orders arrive in stage 5): counted against its limits until released
/// (the order expired or was cancelled before payment).
model CouponRedemption {
  id         String    @id @db.Uuid
  couponId   String    @db.Uuid
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxId  String    @db.Uuid
  sandbox    Sandbox   @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// One coupon per order.
  orderId    String    @unique @db.Uuid
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The coupon's "once per customer", copied in: the partial unique index below needs it in its row.
  exclusive  Boolean
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)

  /// Partial in the migration (WHERE exclusive AND releasedAt IS NULL): a "once per customer" coupon has
  /// one live use per customer (checked under the coupon's lock too; the index is the backstop).
  @@unique([couponId, userId])
  @@index([couponId, sandboxId])
  @@map("coupon_redemptions")
}

/// Where an order is in its life. Money (paid, refunded, disputed) is kept apart, in its own columns: a
/// partly refunded order still ships.
enum OrderStatus {
  /// Placed: stock and coupon held until it's paid or expires (30 minutes).
  pending_payment
  paid
  preparing
  shipped
  delivered
  /// By the customer before paying, or by an admin (with a refund) before shipping.
  canceled
  /// Not paid in time: stock and coupon went back.
  expired
}

/// What a customer bought, frozen when placed: prices, titles, options, address, shipping and coupon as
/// they were. The database refuses to change its money afterwards (see the migration).
model Order {
  id                  String            @id @db.Uuid
  /// For people: "#1042".
  number              Int               @unique @default(autoincrement())
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxId           String            @db.Uuid
  sandbox             Sandbox           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// The cart it came from: one order waiting for payment per cart (a partial unique index).
  cartId              String?           @db.Uuid
  cart                Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  status              OrderStatus       @default(pending_payment)
  email               String            @db.VarChar(254)
  subtotalCents       Int
  discountCents       Int
  shippingCents       Int
  totalCents          Int
  couponId            String?           @db.Uuid
  coupon              Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?           @db.VarChar(30)
  shippingService     String?           @db.VarChar(20)
  shippingDaysMin     Int?
  shippingDaysMax     Int?
  /// The delivery address (physical items only).
  recipient           String?           @db.VarChar(100)
  cep                 String?           @db.Char(8)
  street              String?           @db.VarChar(120)
  streetNumber        String?           @db.VarChar(20)
  complement          String?           @db.VarChar(60)
  district            String?           @db.VarChar(80)
  city                String?           @db.VarChar(80)
  uf                  String?           @db.Char(2)
  /// Until when stock and coupon are held for payment.
  expiresAt           DateTime          @db.Timestamptz(3)
  /// Stripe: the order's PaymentIntent (one at a time; a new attempt only if Stripe cancelled the last).
  paymentIntentId     String?           @unique @db.VarChar(80)
  /// Which PaymentIntent this is for the order (part of its idempotency key).
  paymentAttempt      Int               @default(0)
  /// When Stripe was last asked about it (a sweep asks again after a while).
  paymentCheckedAt    DateTime?         @db.Timestamptz(3)
  /// Set when Stripe's PaymentIntent doesn't match the order (amount, currency, order): never paid, then.
  paymentProblem      String?           @db.VarChar(200)
  latestChargeId      String?           @db.VarChar(80)
  amountPaidCents     Int               @default(0)
  amountRefundedCents Int               @default(0)
  disputeStatus       String?           @db.VarChar(40)
  paidAt              DateTime?         @db.Timestamptz(3)
  trackingCode        String?           @db.VarChar(40)
  shippedAt           DateTime?         @db.Timestamptz(3)
  deliveredAt         DateTime?         @db.Timestamptz(3)
  closedAt            DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  items               OrderItem[]
  events              OrderEvent[]
  redemption          CouponRedemption?
  stockMovements      StockMovement[]

  /// Partial in the migration: WHERE status = 'pending_payment'.
  @@unique([cartId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([status, paymentCheckedAt])
  @@map("orders")
}

/// One line of an order, as it was bought.
model OrderItem {
  id             String      @id @db.Uuid
  orderId        String      @db.Uuid
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String      @db.Uuid
  variant        Variant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  kind           ProductKind
  title          String      @db.VarChar(100)
  /// "250 g · Em grãos"; empty for a single-variant product.
  options        String      @db.VarChar(160)
  sku            String      @db.VarChar(40)
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  /// This line's share of the order's discount.
  discountCents  Int
  weightGrams    Int?
  position       Int

  downloads      Download[]

  @@unique([orderId, variantId])
  @@map("order_items")
}

/// What happened to an order, and who did it: the timeline the customer and the admins see. Append-only.
model OrderEvent {
  id        String   @id @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(40)
  /// Null: the system (expiry, payment confirmations).
  actorId   String?  @db.Uuid
  data      Json     @default("{}")
  createdAt DateTime @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Stripe events received by the webhook, once each (Stripe may send one more than once). Processing goes
/// through the outbox, which retries; what an event says is never trusted: the order asks Stripe.
model PaymentEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(80)
  /// The PaymentIntent, charge, refund or dispute it's about.
  objectId   String   @db.VarChar(255)
  receivedAt DateTime @db.Timestamptz(3)

  @@map("payment_events")
}

/// A download of a purchased digital item (counted; the link itself is signed and short-lived).
model Download {
  id          String    @id @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @db.Timestamptz(3)

  @@index([orderItemId])
  @@map("downloads")
}
