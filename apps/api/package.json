{
  "name": "@torra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:prepare": "node --import tsx scripts/prepare-db.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@torra/shared": "^0.0.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
