# Copy to apps/api/.env for local development.

# Pooled connection used by the running API (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://torra:torra@localhost:5440/torra"
# Direct connection used by `prisma migrate` (on Neon: the host without "-pooler"). Optional locally.
# DIRECT_DATABASE_URL=""

# Exact origins allowed to call the API, comma-separated.
WEB_ORIGINS="http://localhost:3040"
PORT=8050

# The web app's address, for links in emails.
WEB_URL="http://localhost:3040"
# Mailpit (npm run db:up) catches every email: http://localhost:8026. Unset: emails are only kept in the
# database (table sent_emails).
SMTP_URL="smtp://localhost:1026"

# Signs unsubscribe links. Required in production (32+ characters, e.g. `openssl rand -hex 32`);
# unset elsewhere, a fixed development value is used.
# SIGNING_SECRET=""

# Stripe, test mode only (live keys are refused). Unset: a fake gateway simulates card payments, which is
# what tests and end-to-end runs use. From the Stripe Dashboard (a Sandbox for development and CI):
# Developers → API keys. The webhook secret comes from `stripe listen --forward-to
# localhost:8050/api/payments/webhook` (without it, payments still settle: the page and a sweep ask Stripe).
# STRIPE_SECRET_KEY="sk_test_…"
# STRIPE_PUBLISHABLE_KEY="pk_test_…"
# STRIPE_WEBHOOK_SECRET="whsec_…"
# Written on every Stripe object, to tell deployments sharing a Stripe sandbox apart.
# PAYMENTS_ENV="local"
